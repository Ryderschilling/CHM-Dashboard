generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAUSED
  FORMER
}

enum BillingCadence {
  MONTHLY
  PER_VISIT
  AD_HOC
}

enum PaymentStatus {
  PAID
  DUE
  UPCOMING
}

enum PaymentMethod {
  SQUARE
  CASH
  CHECK
  VENMO
  ZELLE
  OTHER
}

enum PaymentCategory {
  RETAINER
  A_LA_CARTE
  PROJECT
  ADD_ON
  OTHER
}

enum JobStatus {
  SCHEDULED
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

/// Where a client's smart water shutoff valve is in its lifecycle.
enum ShutoffStatus {
  QUOTED
  SCHEDULED
  INSTALLED
  REMOVED
}

/// What the device (or the plumber) told us.
enum AlertKind {
  LEAK
  HIGH_FLOW
  SHUTOFF_TRIGGERED
  LOW_TEMP
  FREEZE_RISK
  OFFLINE
  BATTERY
  TEST
  OTHER
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Lifecycle of one year's Coverage Record PDF for one client.

/// A visit report is DRAFT while Ryder is still filling it in and FINAL once
/// it is locked. FINAL reports are what the Coverage Record is built from.
enum VisitReportStatus {
  DRAFT
  FINAL
}

/// State of one checked area on one visit. OK is the default on every area,
/// which is the whole point: the record has to affirmatively document the
/// areas that were fine, not only the ones that were not.
enum FindingState {
  OK
  ISSUE
  NA
}

enum CoverageStatus {
  ENROLLED
  DUE
  DRAFTED
  SENT
}

enum ExpenseCategory {
  LABOR
  SUPPLIES
  GAS
  SOFTWARE
  INSURANCE
  MARKETING
  OTHER
}

model Client {
  id               String         @id @default(cuid())
  name             String
  status           ClientStatus   @default(ACTIVE)
  email            String?
  phone            String?
  altContact       String?
  community        String?
  planName         String?
  planAmount       Decimal?       @db.Decimal(10, 2)
  cadence          BillingCadence @default(MONTHLY)
  lockedRate       Boolean        @default(false)
  lockedUntil      DateTime?
  startDate        DateTime?
  source           String?
  squareCustomerId String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  properties  Property[]
  payments    Payment[]
  jobs        Job[]
  tasks       Task[]
  logs        Note[]
  squareLinks SquareLink[]
  expenses    Expense[]

  shutoffDevices  ShutoffDevice[]
  coverageRecords CoverageRecord[]
  visitReports    VisitReport[]
}

model Property {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label        String?
  address      String
  gateCode     String?
  doorCode     String?
  alarmCode    String?
  wifiName     String?
  wifiPassword String?
  keyLocation  String?
  trashDay     String?
  hvacNotes    String?
  notes        String?
  createdAt    DateTime @default(now())

  jobs           Job[]
  shutoffDevices ShutoffDevice[]
  checkAreas     PropertyCheckArea[]
  visitReports   VisitReport[]
}

model Payment {
  id              String          @id @default(cuid())
  clientId        String?
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  amount          Decimal         @db.Decimal(10, 2)
  status          PaymentStatus   @default(PAID)
  dueDate         DateTime?
  paidDate        DateTime?
  method          PaymentMethod?
  category        PaymentCategory @default(RETAINER)
  description     String?
  invoiceNumber   String?
  squareInvoiceId String?
  expenses        Expense[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Worker {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  email      String?
  defaultPay Decimal? @db.Decimal(10, 2)
  payNote    String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  jobs     Job[]
  expenses Expense[]
}

model Job {
  id           String    @id @default(cuid())
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  propertyId   String?
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  title        String
  jobType      String?
  date         DateTime
  status       JobStatus @default(SCHEDULED)
  workerId     String?
  worker       Worker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  /// What was actually paid out to a worker for this job. 0 when Ryder did it.
  laborCost    Decimal   @default(0) @db.Decimal(10, 2)
  /// Time on the job, tracked whether or not anyone was paid.
  laborHours   Decimal?  @db.Decimal(6, 2)
  /// Explicit one-off charge. Leave null when the visit is covered by a plan;
  /// lib/jobValue.ts then allocates a share of the client's monthly plan.
  chargeAmount Decimal?  @db.Decimal(10, 2)
  durationMin  Int?
  notes        String?
  /// End of the time block. Null means use durationMin, or treat as a point in time.
  endDate      DateTime?
  allDay       Boolean   @default(false)
  location     String?

  // --- Google Calendar link ---
  /// The Google event id. For an occurrence of a recurring series this is the
  /// instance id (e.g. "abc123_20260805T140000Z"), so each visit is its own row.
  gcalEventId  String?   @unique
  /// recurringEventId when this job is one occurrence of a series.
  gcalSeriesId String?
  /// Google's `updated` timestamp at the last successful sync. Used to decide
  /// whether Google or CHM has the fresher version of the scheduling fields.
  gcalUpdated  DateTime?
  syncedAt     DateTime?

  tasks       Task[]
  visitReport VisitReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gcalSeriesId])
  @@index([date])
}

model Task {
  id        String       @id @default(cuid())
  title     String
  done      Boolean      @default(false)
  dueDate   DateTime?
  priority  TaskPriority @default(NORMAL)
  clientId  String?
  client    Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Optional link to the job this is a step of. Job checklists render from this
  /// and get written into the Google event description so they show on the phone.
  jobId     String?
  job       Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([jobId])
}

model Expense {
  id          String          @id @default(cuid())
  date        DateTime
  amount      Decimal         @db.Decimal(10, 2)
  category    ExpenseCategory @default(OTHER)
  vendor      String?
  description String?
  workerId    String?
  worker      Worker?         @relation(fields: [workerId], references: [id], onDelete: SetNull)
  /// Optional link to the invoice/payment this cost belongs to,
  /// so per-invoice profit = payment amount minus its linked expenses.
  paymentId   String?
  payment     Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  /// Optional link to a client, so per-client cost and true spread work.
  /// Auto-filled from the invoice's client when attached to a payment.
  clientId    String?
  client      Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
}

model Note {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

/// A smart automatic water shutoff valve on a client's main line.
/// Sold at $1,295 installed plus $35/mo to monitor. Monitoring is bundled
/// into the Coastal Elite plan. Read the public site's src/data/protection.ts
/// before writing any client-facing copy about this: we never claim it lowers
/// anyone's premium, we say the client's own carrier may publish a credit.
model ShutoffDevice {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  status       ShutoffStatus @default(QUOTED)
  /// Phyn Plus, Flo by Moen, FloLogic, Water Hero, Leak Defense, Moen Smart Water.
  brand        String?
  model        String?
  serialNumber String?

  installDate  DateTime?
  /// Which plumber put it in, so warranty calls go to the right person.
  installedBy  String?
  /// What the client paid for the install.
  installPrice Decimal?  @db.Decimal(10, 2)
  /// What the hardware plus plumber cost us. installPrice minus this is the margin.
  installCost  Decimal?  @db.Decimal(10, 2)

  /// True when we are holding the alerts and responding.
  monitored     Boolean  @default(false)
  monitoringFee Decimal? @db.Decimal(10, 2)

  /// Last time we confirmed the device was online and healthy.
  lastCheckedAt DateTime?
  warrantyEnd   DateTime?
  notes         String?

  alerts    ShutoffAlert[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([clientId])
  @@index([status])
}

/// One thing the shutoff device reported, and what we did about it.
/// Every row here is also evidence: it is dated, it names the property, and
/// it records the response. Keep resolvedAt honest.
model ShutoffAlert {
  id       String        @id @default(cuid())
  deviceId String
  device   ShutoffDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  occurredAt DateTime
  kind       AlertKind     @default(OTHER)
  severity   AlertSeverity @default(WARNING)
  /// One line, what the alert said.
  summary    String
  /// What we did. Drove over, closed the valve, called the plumber.
  action     String?
  /// Null means still open.
  resolvedAt DateTime?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([deviceId])
  @@index([occurredAt])
  @@index([resolvedAt])
}

/// One year's Coverage Record for one client: the dated PDF of every visit,
/// $195/year, included on Coastal Elite. A row existing means the client is
/// enrolled for that period. dueDate drives the "who do I owe a PDF" list.
model CoverageRecord {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  /// When Ryder wants it in the client's hands. Usually periodEnd plus a couple weeks.
  dueDate     DateTime
  status      CoverageStatus @default(ENROLLED)
  sentDate    DateTime?
  /// What they pay for it. Null on Coastal Elite, where it is included.
  fee         Decimal?       @db.Decimal(10, 2)
  /// Where the finished PDF lives (Drive link, local path, whatever).
  fileUrl     String?
  /// Snapshot of what went into the document, filled when it is built.
  visitCount  Int?
  photoCount  Int?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([dueDate])
  @@index([status])
}

/// The list of areas checked at ONE property, editable per house. Seeded from
/// the default template in src/lib/checkAreas.ts, then trimmed or added to.
/// A house with no pool should not have a pool line in its record.
model PropertyCheckArea {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label      String
  /// Interior / Systems / Exterior / Security. Groups the form and the PDF.
  category   String   @default("Interior")
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([propertyId, sortOrder])
}

/// One home watch visit, written up on site. This is the evidence record.
/// Reporting a visit also writes back to its Job (hours, cost, charge, DONE)
/// so the existing money model in lib/jobValue.ts and lib/metrics.ts picks it
/// up. Do NOT build a second accounting path here.
model VisitReport {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  /// The calendar job this visit belongs to. One report per job.
  jobId      String?   @unique
  job        Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  visitDate     DateTime
  /// Minutes on site. Mirrored onto Job.laborHours so time reporting works.
  minutesOnSite Int?
  weather       String?

  status        VisitReportStatus @default(DRAFT)
  /// What the client is told. Goes on the visit PDF verbatim.
  summary       String?
  /// Never shown to the client, never in the PDF.
  internalNotes String?

  /// Billable beyond the plan. Mirrored onto Job.chargeAmount.
  chargeAmount Decimal? @db.Decimal(10, 2)
  /// Paid out to a helper for this visit. Mirrored onto Job.laborCost.
  laborCost    Decimal? @db.Decimal(10, 2)
  /// Out of pocket on this visit (filters, supplies). Creates an Expense row.
  materialCost Decimal? @db.Decimal(10, 2)
  materialNote String?

  findings VisitFinding[]
  photos   VisitPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([visitDate])
  @@index([status])
}

/// One area, on one visit, with the state it was found in.
/// `label` is a SNAPSHOT taken at report time on purpose. Renaming an area
/// later must not rewrite what a past record says.
model VisitFinding {
  id        String       @id @default(cuid())
  reportId  String
  report    VisitReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  areaId    String?
  label     String
  category  String       @default("Interior")
  state     FindingState @default(OK)
  note      String?
  sortOrder Int          @default(0)

  photos VisitPhoto[]

  @@index([reportId, sortOrder])
}

/// Photos live as bytes in Postgres so there is exactly one source of truth
/// across localhost and Vercel, and no storage account to set up. The form
/// resizes to 1400px / JPEG 0.7 in the browser before upload, so a photo is
/// roughly 120-180KB. /visits shows total storage used. If that number gets
/// close to the Neon plan limit, move `data` to Vercel Blob and keep the row.
model VisitPhoto {
  id        String        @id @default(cuid())
  reportId  String
  report    VisitReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Optional link to the area this photo documents.
  findingId String?
  finding   VisitFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  data      Bytes
  mimeType  String  @default("image/jpeg")
  bytes     Int     @default(0)
  width     Int?
  height    Int?
  caption   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([reportId, sortOrder])
  @@index([findingId])
}

/// Maps Square customer IDs to clients. One client can own several
/// Square records (spouses, duplicate directory entries).
model SquareLink {
  squareCustomerId String @id
  clientId         String
  client           Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

/// Tiny key-value store (last Square sync time, etc).
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
